@page "/"
@namespace XafXPODynAssem.Blazor.Server
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using DevExpress.ExpressApp.Blazor.Components

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, shrink-to-fit=no" />
    <meta name="mobile-web-app-capable" content="yes" />
    <!-- meta name="theme-color" content="#000000" -->
    <title>Mordeczka</title>
    <base href="~/" />
    <link rel="icon" type="image/svg+xml" href="images/Logo.svg" />
    <style>
        /* Mordeczka na ekranie ladowania ma wypelniac kolo, a nie siedziec w nim jak znaczek. */
        #applicationLoadingPanel .loading-image { width: 66%; height: 66%; }
    </style>
    <component type="typeof(BootstrapThemeLink)" render-mode="Static" />
</head>
<body>
    <component type="typeof(SplashScreen)" render-mode="Static" param-Caption='"Mordeczka"' param-ImagePath='"images/SplashScreen.svg"' />

    <link href="_content/DevExpress.ExpressApp.Blazor/styles.css" asp-append-version="true" rel="stylesheet" />
    <link href="css/site.css" rel="stylesheet" />
    <!-- Uncomment this link to enable CSS isolation. For more information, refer to the following topic: https://learn.microsoft.com/en-us/aspnet/core/blazor/components/css-isolation -->
    <!-- <link href="XafXPODynAssem.Blazor.Server.styles.css" rel="stylesheet"> -->

    <app class="d-none">
        <component type="typeof(App)" render-mode="Server" />
    </app>

    <component type="typeof(AlertsHandler)" render-mode="Server" />

    <div id="blazor-error-ui">
        <component type="typeof(BlazorError)" render-mode="Static" />
    </div>

    <script src="_framework/blazor.server.js"></script>
    <script src="~/js/replika.js" asp-append-version="true"></script>
    <script>
        // Samoczynny powrot po Deploy Schema.
        //
        // Deploy konczy proces kodem 42 i serwer wstaje na nowo w kilkanascie sekund,
        // ale wraz z nim ginie obwod Blazora. Proba wznowienia laczy sie wiec z czyms,
        // czego juz nie ma, i domyslny baner „Could not reconnect" zostaje na ekranie
        // az do recznego odswiezenia. Ponizsze doklada brakujacy krok: kiedy baner
        // wisi, odpytujemy serwer i przeladowujemy strone, gdy tylko odpowie.
        //
        // Zwykle mrugniecie sieci obsluguje sam Blazor — dlatego czekamy chwile (GRACJA)
        // i rezygnujemy, jesli baner zniknie sam. Przeladowujemy dopiero, gdy serwer
        // odpowiada, wiec uzytkownik nie trafia na strone bledu.
        (function () {
            var GRACJA = 4000;      // ile baner musi wisiec, zanim uznamy obwod za stracony
            var ODSTEP = 1500;      // co ile pytamy serwer
            var LIMIT = 180000;     // po tylu ms przestajemy probowac
            var odkad = null, wznawiamy = false;

            function banerWisi() {
                var el = document.getElementById('components-reconnect-modal');
                if (el && getComputedStyle(el).display !== 'none') return true;
                // XAF/DevExpress potrafi pokazac wlasny komunikat zamiast domyslnego
                return /Could not reconnect|Nie można ponownie połączyć/i.test(document.body.innerText);
            }

            function czekajNaSerwerIWznow() {
                if (wznawiamy) return;
                wznawiamy = true;
                var start = Date.now();
                (function pytaj() {
                    if (!banerWisi()) { wznawiamy = false; odkad = null; return; }   // wrocil sam
                    if (Date.now() - start > LIMIT) { wznawiamy = false; return; }
                    fetch(document.baseURI, { method: 'GET', cache: 'no-store' })
                        .then(function (r) {
                            if (r.ok) { location.reload(); } else { setTimeout(pytaj, ODSTEP); }
                        })
                        .catch(function () { setTimeout(pytaj, ODSTEP); });
                })();
            }

            setInterval(function () {
                if (banerWisi()) {
                    if (odkad === null) odkad = Date.now();
                    else if (Date.now() - odkad >= GRACJA) czekajNaSerwerIWznow();
                } else {
                    odkad = null;
                }
            }, 1000);
        })();

        window.schemaFile = {
            download: function (fileName, content) {
                var blob = new Blob([content], { type: 'application/json' });
                var url = URL.createObjectURL(blob);
                var a = document.createElement('a');
                a.href = url;
                a.download = fileName;
                document.body.appendChild(a);
                a.click();
                document.body.removeChild(a);
                URL.revokeObjectURL(url);
            },
            upload: function (accept) {
                return new Promise(function (resolve) {
                    var input = document.createElement('input');
                    input.type = 'file';
                    input.accept = accept || '.json';
                    input.onchange = function () {
                        var file = input.files[0];
                        if (!file) { resolve(null); return; }
                        var reader = new FileReader();
                        reader.onload = function () { resolve(reader.result); };
                        reader.readAsText(file);
                    };
                    input.click();
                });
            }
        };
    </script>
</body>
</html>
