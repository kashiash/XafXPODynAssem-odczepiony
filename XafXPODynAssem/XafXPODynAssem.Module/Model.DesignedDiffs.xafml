<?xml version="1.0" ?>
<Application Title="XafXPODynAssem">
  <BOModel>
    <Class Name="DevExpress.Persistent.BaseImpl.PermissionPolicy.PermissionPolicyUser" Caption="Base User" />
  </BOModel>
  <Options>
    <LayoutManagerOptions RequiredFieldMark="*" />
  </Options>
  <Views>
    <ListView Id="ApplicationUser_ListView" Caption="Users" />
  </Views>
  <NavigationHub>
    <Item Id="Start" Caption="Start" SortOrder="0" IsNewNode="True">
      <Buttons>
        <Item Id="AsystentAI" Caption="Asystent AI" ImageName="Action_AI"
              NavigationItemId="AIChat_ListView" Color="#1976D2" SortOrder="0" IsNewNode="True" />
        <Item Id="Raporty" Caption="Raporty" ImageName="BO_Report"
              NavigationItemId="ReportDataV2_ListView" Color="#00796B" SortOrder="1" IsNewNode="True" />
      </Buttons>
    </Item>
    <Item Id="Schemat" Caption="Zarządzanie schematem" SortOrder="10" IsNewNode="True">
      <Buttons>
        <Item Id="KlasyUzytkownika" Caption="Klasy użytkownika" ImageName="ModelEditor_Class_Object"
              NavigationItemId="CustomClass_ListView" Color="#F57C00" SortOrder="0" IsNewNode="True" />
        <Item Id="HistoriaSchematu" Caption="Historia schematu" ImageName="Action_AboutInfo"
              NavigationItemId="SchemaHistory_ListView" Color="#F57C00" SortOrder="1" IsNewNode="True" />
      </Buttons>
    </Item>
    <Item Id="Administracja" Caption="Administracja" SortOrder="90" IsNewNode="True">
      <Buttons>
        <Item Id="Uzytkownicy" Caption="Użytkownicy" ImageName="BO_User"
              NavigationItemId="ApplicationUser_ListView" Color="#7B1FA2" SortOrder="0" IsNewNode="True" />
        <Item Id="Role" Caption="Role" ImageName="BO_Role"
              NavigationItemId="PermissionPolicyRole_ListView" Color="#7B1FA2" SortOrder="1" IsNewNode="True" />
      </Buttons>
    </Item>
  </NavigationHub>
</Application>
